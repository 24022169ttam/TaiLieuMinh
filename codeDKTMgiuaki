    return {
        "d": round(r.dist, 2), "w": r.water, "car": int(r.car), "ang": r.pos, "tgt": r.tgt,
        "auto": int(r.auto), "st": r.state, "buz": int(r.buz), "mute": int(r.muted),
        "latch": int(r.latched), "blk": int(r.blocked), "l1": r.lcd1, "l2": r.lcd2,
        "td": cfg["deep"], "tw": cfg["warn"], "tx": cfg["water"], "txw": cfg["wwarn"],
        "up": now() // 1000, "rssi": rssi,
        "ip": sta.ifconfig()[0] if connected else (ap.ifconfig()[0] if getattr(C, "ENABLE_AP", False) else "-"),
        "sw": int(sw_manual()), "bo": int(btn_open.stable == 0), "bc": int(btn_close.stable == 0),
        "dry": cfg["dry"], "rate": round(r.rate, 2), "eta": r.eta, "early": cfg["early"], "pre": int(r.pre),
        "diag": r.diag, "nz": round(r.noise, 2), "carT": r.car_sec, "stuck": int(r.stuck),
        "nf": stats["nf"], "fs": stats["fs"], "mx": stats["mx"],
        "la": since(r.last_flood) // 1000 if r.last_flood else -1, "np": stats["np"],
        "test": r.test, "lt": r.last_test,
        "sc": C.SERVO_CLOSED,
    }


def unquote(s):
    s = s.replace("+", " ")
    out = bytearray()
    i = 0
    while i < len(s):
        if s[i] == "%" and i + 2 < len(s) + 1:
            try:
                out.append(int(s[i + 1:i + 3], 16))
                i += 3
                continue
            except ValueError:
                pass
        out += s[i].encode()
        i += 1
    return out.decode()


def query(path):
    q = {}
    if "?" in path:
        for kv in path.split("?", 1)[1].split("&"):
            if "=" in kv:
                k, v = kv.split("=", 1)
                q[k] = unquote(v)
    return q


async def send_resp(w, code, ctype, body):
    if isinstance(body, str):
        body = body.encode()
    w.write((("HTTP/1.1 %d OK\r\nContent-Type: %s\r\nContent-Length: %d\r\n"
             "Cache-Control: no-store\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n")
            % (code, ctype, len(body))).encode())
    w.write(body)
    await w.drain()


async def send_page(w):
    import os
    size = os.stat("hmi.html")[6]
    w.write(("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nContent-Length: %d\r\n"
            "Connection: close\r\n\r\n" % size).encode())
    await w.drain()
    with open("hmi.html", "rb") as f:          # gui tung khuc 1 KB, khong nap ca file vao RAM
        while True:
            chunk = f.read(1024)
            if not chunk:
                break
            w.write(chunk)
            await w.drain()


async def http_handler(reader, writer):
    try:
        line = await reader.readline()
        if line:
            parts = line.decode().split(" ")
            path = parts[1] if len(parts) > 1 else "/"
            while True:                         # bo qua header
                h = await reader.readline()
                if not h or h == b"\r\n":
                    break
            if path.startswith("/api/state"):
                q = query(path)
                after = int(q.get("ev", "0") or 0)
                t = now()
                evs = [{"id": i, "m": m, "lv": lv, "ago": time.ticks_diff(t, ts) // 1000}
                       for (i, m, lv, ts) in events if i > after]
                await send_resp(writer, 200, "application/json",
                                json.dumps({"boot": BOOT_ID, "s": state_dict(), "ev": evs}))
            elif path.startswith("/api/cmd"):
                handle_command(query(path).get("c", ""))
                await send_resp(writer, 200, "text/plain", "OK")
            elif path == "/" or path.startswith("/?") or path.startswith("/index"):
                await send_page(writer)
            else:
                writer.write(b"HTTP/1.1 302 Found\r\nLocation: /\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
                await writer.drain()
    except Exception as e:
        print("HTTP loi:", e)
    finally:
        try:
            writer.close()
            await writer.wait_closed()
        except Exception:
            pass
        gc.collect()

