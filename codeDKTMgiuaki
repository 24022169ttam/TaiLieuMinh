import time
import config as C
from state import *
from hw import *


LOOP_MS = 50


MIS_TICKS = C.MISMATCH_SEC * 1000 // LOOP_MS


def update_diag():
    b = 0
    if r.dist < 0 and since(r.last_valid) > C.US_LOST_MS:   # chi bao khi that su mat echo > 3 s
        b |= 1
    noisy = r.noise > (C.NOISE_OFF_CM if r.diag & 2 else C.NOISE_ON_CM)
    if r.dist > 0 and noisy:
        b |= 2
    r.misA = r.misA + 1 if (r.water >= cfg["water"] and r.dist > 0 and depth() < 0.5) else 0
    r.misB = r.misB + 1 if (r.dist > 0 and r.dist < cfg["deep"] and r.water < C.DRY_FLOOR_ADC) else 0
    if r.misA > MIS_TICKS:
        b |= 4
    if r.misB > MIS_TICKS:
        b |= 8
    on, off = b & ~r.diag, r.diag & ~b
    if on & 1:
        event("Mất tín hiệu cảm biến siêu âm HY-SRF05, chuyển sang mức cảnh báo", 2)
    if off & 1:
        event("Cảm biến siêu âm hoạt động lại", 0)
    if on & 2:
        event("Siêu âm nhiễu cao, có thể mặt nước đang gợn sóng", 1)
    if on & 4:
        event("Lệch cảm biến: sàn ướt nhưng siêu âm báo khô", 1)
    if on & 8:
        event("Lệch cảm biến: siêu âm báo ngập nhưng sàn khô", 1)
    r.diag = b


rh = []                                         # lich su khoang cach, 1 mau/giay


def update_rate():
    rh.append(r.dist)
    if len(rh) > C.RATE_WINDOW:
        rh.pop(0)
    pts = [(i, y) for i, y in enumerate(rh) if y > 0]
    n = len(pts)
    if n < 8:
        r.rate, r.eta = 0.0, -1
        return
    sx = sum(p[0] for p in pts)
    sy = sum(p[1] for p in pts)
    sxx = sum(p[0] * p[0] for p in pts)
    sxy = sum(p[0] * p[1] for p in pts)
    den = n * sxx - sx * sx
    slope = (n * sxy - sx * sy) / den if den else 0.0      # cm/giay (am = nuoc dang)
    r.rate = -slope * 60.0
    if r.rate >= C.RATE_MIN_CM_MIN and r.dist > cfg["deep"]:
        r.eta = int((r.dist - cfg["deep"]) / (r.rate / 60.0))
    else:
        r.eta = -1


def on_state_change(old, st):
    if st == ST_DEEP:
        stats["nf"] += 1
        r.flood_start = r.last_flood = now()
        if 0 < r.dist < cfg["deep"]:
            event("NGẬP SÂU: mặt nước cách cảm biến %.1f cm" % r.dist, 2)
        else:
            event("NGẬP SÂU: cảm biến nước %d" % r.water, 2)
    if old == ST_DEEP:
        stats["fs"] += since(r.flood_start) // 1000
        r.last_flood = now()
        save_json("stats.json", stats)
    if st == ST_WARN:
        if r.dist > 0:
            event("CẢNH BÁO: mặt nước %.1f cm, nguy cơ ngập" % r.dist, 1)
        else:
            event("CẢNH BÁO: không đo được mực nước, giữ mức an toàn", 1)
    if st == ST_RECEDE:
        event("Nước đã rút, cửa vẫn đóng, chờ xác nhận mở", 3)
    if st == ST_SAFE:
        event("Trạng thái AN TOÀN", 0)


def update_logic():
    deep = (0 < r.dist < cfg["deep"]) or r.water >= cfg["water"]
    warn = (not deep) and ((0 < r.dist < cfg["warn"]) or r.water >= cfg["wwarn"]
                           or (r.diag & 1) or (r.pre and r.eta >= 0))
    old = r.state
    st = ST_DEEP if deep else ST_WARN if warn else ST_RECEDE if r.latched else ST_SAFE
    if st != old and st in (ST_DEEP, ST_SAFE):
        r.muted = False                          # coi tu bat lai khi ngap moi / da an toan
    r.state = st
    if st != old:
        on_state_change(old, st)

    if r.car:
        if not r.car_since:
            r.car_since = now()
        r.car_sec = since(r.car_since) // 1000
    else:
        r.car_since = 0
        r.car_sec = 0
    stuck = st == ST_DEEP and r.car_sec >= C.CAR_STUCK_SEC
    if stuck and not r.stuck:
        event("XE KẸT tại cửa hầm hơn 30 giây khi đang ngập sâu!", 2)
    r.stuck = stuck
    if st == ST_DEEP:
        stats["mx"] = max(stats["mx"], round(depth(), 1))

    if r.auto and r.test < 0:
        if st == ST_DEEP:
            if r.car:
                r.tgt = C.SERVO_OPEN             # co xe: giu cua nam tren doc de xe ra
            else:
                r.tgt = C.SERVO_CLOSED
                r.latched = True
        elif st == ST_SAFE:
            r.tgt = C.SERVO_OPEN
        elif st == ST_RECEDE:
            r.tgt = C.SERVO_CLOSED               # cho nguoi xac nhan
        # dong cua som theo du bao
        if st != ST_DEEP and not r.latched and cfg["early"] > 0 and 0 <= r.eta <= cfg["early"] and not r.car:
            r.tgt = C.SERVO_CLOSED
            r.latched = True
            r.pre = True
            stats["np"] += 1
            save_json("stats.json", stats)
            event("Đóng cửa sớm theo dự báo: nước dâng %.1f cm/phút, còn %d s tới ngập sâu" % (r.rate, r.eta), 1)

    if r.car and r.tgt == C.SERVO_CLOSED and r.pos < C.SERVO_CLOSED - 5 and (r.auto or C.INTERLOCK_MANUAL):
        r.tgt = C.SERVO_OPEN                     # xe xuat hien khi cua dang dung -> ha lai
        r.blocked = True
    else:
        r.blocked = False
    r.buz = st == ST_DEEP and not r.muted


def finish_test(msg, ok):
    r.last_test = 1 if ok else 2
    r.test = -1
    event(msg, 0 if ok else 2)


def update_test():
    if r.test < 0:
        return
    t = since(r.test_t0)
    if r.state != ST_SAFE or r.car:
        r.tgt = C.SERVO_OPEN
        finish_test("Tự kiểm tra bị hủy: điều kiện thay đổi", False)
        return
    if t < 1000:
        r.test = 0                               # bat ca 3 LED
    elif t < 1400:
        r.test = 1                               # thu coi
    elif t < 3000:
        r.test = 2
        r.tgt = C.SERVO_CLOSED
    elif t < 4600:
        r.test = 3
        r.tgt = C.SERVO_OPEN
    else:
        ok = r.dist > 0 and r.diag == 0 and r.pos == C.SERVO_OPEN
        finish_test("Tự kiểm tra ĐẠT: LED, còi, servo, siêu âm" if ok
                    else "Tự kiểm tra KHÔNG ĐẠT: kiểm tra cảm biến siêu âm", ok)


def build_lcd():
    d = ("%4.1f" % depth()) if r.dist > 0 else " ---"
    r.lcd1 = "H%scm W%4d %s" % (d, r.water, "A" if r.auto else "M")
    if r.test >= 0:
        s2 = "TU KIEM TRA..."
    elif r.stuck:
        s2 = "XE KET CUA HAM!"
    elif r.state == ST_DEEP:
        s2 = "NGAP! CO XE-MO" if r.car else "NGAP SAU! DONG"
    elif r.diag & 1:
        s2 = "LOI SIEU AM!"
    elif r.state == ST_WARN:
        s2 = "DONG SOM-DU BAO" if r.pre else "CANH BAO:NGUY CO"
    elif r.state == ST_RECEDE:
        s2 = "NUOC RUT-CHO MO"
    else:
        s2 = "AN TOAN  CUA MO"
    r.lcd2 = s2

