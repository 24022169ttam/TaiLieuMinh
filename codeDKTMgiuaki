                sta.disconnect()
                sta.connect(ssid, pw)
            except Exception as e:
                print("Loi ket noi:", e)


async def control_loop():
    t_rate = t_lcd = now()
    r.last_valid = now()                        # tranh bao nham mat sieu am ngay khi khoi dong
    while True:
        try:
            read_sensors()
            read_buttons()
            update_diag()
            update_logic()
            update_test()
            build_lcd()
            update_servo()
            update_indicators()
            if since(t_rate) >= 1000:
                t_rate = now()
