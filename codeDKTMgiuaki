def read_water():
    try:
        return adc.read_u16() >> 4             # 0 - 4095 nhu analogRead cua Arduino
    except AttributeError:
        return adc.read()


def servo_write(deg):
    us = C.SERVO_MIN_US + (C.SERVO_MAX_US - C.SERVO_MIN_US) * deg // 180
    try:
        servo.duty_ns(us * 1000)
    except AttributeError:
        servo.duty(us * 1023 // 20000)


lcd = None          # duoc main.py truyen vao qua start()


def lcd_line(row, s):
    if lcd:
        try:
            lcd.line(row, s)
        except Exception:
            pass


med = [-1.0] * 5


med_i = 0


def us_once():
    trig.value(0)
    time.sleep_us(2)
    trig.value(1)
    time.sleep_us(10)
    trig.value(0)
    t = time_pulse_us(echo, 1, 12000)          # toi da ~2 m
    return t * 0.0343 / 2 if t > 0 else -1.0


def read_sensors():
    global med_i
    med[med_i] = us_once()
    med_i = (med_i + 1) % 5
    a = sorted(x for x in med if x > 0)
    if len(a) >= 3:                             # loc trung vi 5 mau
        r.dist = a[len(a) // 2]
        r.noise = a[-1] - a[0]
        r.last_valid = now()
    elif since(r.last_valid) > C.US_LOST_MS:
        r.dist = -1.0
        r.noise = 0.0
    r.water = read_water()
    r.car = ir.value() == 0                     # FC-51: 0 = co vat can


class Btn:
    def __init__(self, pin):
        self.p = Pin(pin, Pin.IN, Pin.PULL_UP)
        self.stable = self.raw = self.p.value()
        self.t = now()

    def changed(self):                          # chong doi 30 ms
        v = self.p.value()
        if v != self.raw:
            self.raw = v
            self.t = now()
        if self.raw != self.stable and since(self.t) > 30:
            self.stable = self.raw
            return True
        return False


sw_mode = Btn(C.PIN_SW_MODE)


btn_open = Btn(C.PIN_BTN_OPEN)


btn_close = Btn(C.PIN_BTN_CLOSE)


def sw_manual():
    return sw_mode.stable == C.SW_MANUAL_LEVEL


def update_servo():
    step = 15                                    # ~300 do/giay
    if r.pos < r.tgt:
        r.pos = min(r.tgt, r.pos + step)
        servo_write(r.pos)
    elif r.pos > r.tgt:
        r.pos = max(r.tgt, r.pos - step)
        servo_write(r.pos)


def update_indicators():
    ms = now()
    g = y = rd = False
    bz = r.buz and (ms // 80) % 2 == 1
    if r.test == 0:
        g = y = rd = True
        bz = False
    elif r.test == 1:
        bz = True
    elif not r.auto and not C.MANUAL_ALARMS:
        bz = False
    elif r.state == ST_SAFE:
        g = True
    elif r.state == ST_WARN:
        y = (ms // 500) % 2 == 1                 # vang nhay 500 ms
    elif r.state == ST_DEEP:
        rd = (ms // 150) % 2 == 1                # do nhay 150 ms
    else:
        rd = True                                # nuoc rut: do sang dung
    led_g.value(g)
    led_y.value(y)
    led_r.value(rd)
    buzzer.value(bz)

