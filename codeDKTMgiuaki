async def wifi_keeper():
    was = sta.isconnected()
    while True:
        await asyncio.sleep(15)
        now_conn = sta.isconnected()
        if now_conn and not was:
            print("Da ket noi lai Wi-Fi:", sta.ifconfig()[0])
            event("Đã kết nối lại Wi-Fi, HMI: http://" + sta.ifconfig()[0], 0)
