# FILE: lcd_i2c.py  –  Driver LCD 16x2 I2C
#==============================================================================
# lcd_i2c.py - Driver LCD 16x2 qua module I2C PCF8574 (MicroPython)
# Mapping chuan: P0=RS, P1=RW, P2=E, P3=den nen, P4..P7=D4..D7
import time

class LCD:
    def __init__(self, i2c, addr=0x27, cols=16, rows=2):
        self.i2c = i2c
        self.addr = addr
        self.cols = cols
        self.rows = rows
        self.bl = 0x08
        time.sleep_ms(50)
        for _ in range(3):                 # dua LCD ve che do 8 bit roi chuyen 4 bit
            self._nibble(0x30, 0)
            time.sleep_ms(5)
        self._nibble(0x20, 0)
        time.sleep_ms(1)
        self.cmd(0x28)                     # 4 bit, 2 dong, font 5x8
        self.cmd(0x0C)                     # bat hien thi, tat con tro
        self.cmd(0x06)                     # tu tang dia chi
        self.clear()

    def _nibble(self, val, rs):
        b = (val & 0xF0) | rs | self.bl
        self.i2c.writeto(self.addr, bytes([b | 0x04, b]))   # xung E

    def _bytes(self, val, rs):
        hi = (val & 0xF0) | rs | self.bl
        lo = ((val << 4) & 0xF0) | rs | self.bl
        return bytes([hi | 0x04, hi, lo | 0x04, lo])

    def cmd(self, c):
        self.i2c.writeto(self.addr, self._bytes(c, 0))
        if c <= 3:
            time.sleep_ms(2)

    def clear(self):
        self.cmd(0x01)

    def move(self, col, row):
        self.cmd(0x80 | (col + (0x40 if row else 0)))

    def print(self, s):
        buf = bytearray()
        for ch in s:
            o = ord(ch)
            buf += self._bytes(o if o < 128 else 0x3F, 1)   # ky tu co dau -> '?'
        self.i2c.writeto(self.addr, buf)

    def line(self, row, s):
        self.move(0, row)
        self.print((s + " " * self.cols)[:self.cols])
