trig = Pin(C.PIN_TRIG, Pin.OUT, value=0)


echo = Pin(C.PIN_ECHO, Pin.IN)


adc = ADC(Pin(C.PIN_WATER))


adc.atten(ADC.ATTN_11DB)                       # do 0 - 3.3 V


ir = Pin(C.PIN_IR, Pin.IN, Pin.PULL_UP)


buzzer = Pin(C.PIN_BUZZER, Pin.OUT, value=0)


led_g = Pin(C.PIN_LED_G, Pin.OUT, value=0)


