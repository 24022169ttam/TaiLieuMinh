import config as C
from state import *
from hw import *


def request_close():
    if r.car and (r.auto or C.INTERLOCK_MANUAL):
        event("Từ chối đóng cửa: có xe tại cửa hầm", 2)
        return False
    r.tgt = C.SERVO_CLOSED
    return True


def confirm_open():
    if r.state == ST_RECEDE:
        r.latched = False
        r.pre = False
        r.tgt = C.SERVO_OPEN
        r.state = ST_SAFE
        event("Đã xác nhận, mở lại cửa chắn nước", 0)
        return True
    return False


def start_test():
    if r.state != ST_SAFE or r.car or r.latched:
        event("Không thể tự kiểm tra: hệ thống phải AN TOÀN, cửa trống", 1)
        return False
    r.test = 0
    r.test_t0 = now()
    event("Bắt đầu tự kiểm tra hệ thống", 3)
    return True


def calibrate():
    if r.dist > 0 and r.water < cfg["water"] and r.state == ST_SAFE:
        cfg["dry"] = round(r.dist, 1)
        save_json("settings.json", cfg)
        event("Đã hiệu chuẩn mốc khô: %.1f cm" % cfg["dry"], 0)
    else:
        event("Không hiệu chuẩn được: cần rãnh khô và siêu âm đọc tốt", 1)


def handle_command(c):
    c = c.strip()
    if c == "MODE:AUTO":
        r.auto = True
    elif c == "MODE:MAN":
        r.auto = False
    elif c == "GATE:OPEN":
        if not r.auto:
            r.tgt = C.SERVO_OPEN
    elif c == "GATE:CLOSE":
        if not r.auto:
            request_close()
    elif c == "MUTE:1":
        r.muted = True
    elif c == "MUTE:0":
        r.muted = False
    elif c == "CONFIRM":
        confirm_open()
    elif c == "TEST":
        start_test()
    elif c == "CAL":
        calibrate()
    elif c == "RSTAT":
        stats.update({"nf": 0, "fs": 0, "mx": 0.0, "np": 0})
        r.last_flood = 0
        save_json("stats.json", stats)
        event("Đã đặt lại thống kê ngập", 3)
    elif c.startswith("CFG:"):
        try:
            p = c[4:].split(",")
            d, w, x, e, dr, xw = float(p[0]), float(p[1]), int(p[2]), int(p[3]), float(p[4]), int(p[5])
            if d > 0 and w > d and 0 <= xw < x <= 4095 and 0 <= e <= 600 and dr > w:
                cfg.update({"deep": d, "warn": w, "water": x, "wwarn": xw, "early": e, "dry": dr})
                save_json("settings.json", cfg)
                event("Đã lưu cấu hình mới", 3)
            else:
                event("Cấu hình không hợp lệ, không lưu", 2)
        except Exception:
            event("Cấu hình không hợp lệ, không lưu", 2)


def read_buttons():
    if sw_mode.changed():
        r.auto = not sw_manual()
        event("Công tắc: chuyển TỰ ĐỘNG" if r.auto else "Công tắc: chuyển THỦ CÔNG", 3)
    if btn_open.changed() and btn_open.stable == 0:
        if r.state == ST_RECEDE:
            confirm_open()
        elif not r.auto:
            r.tgt = C.SERVO_OPEN
            event("Nút cứng: mở cửa", 3)
        else:
            event("Nút Mở cửa bị bỏ qua: đang ở chế độ TỰ ĐỘNG", 1)
    if btn_close.changed() and btn_close.stable == 0:
        if not r.auto:
            request_close()
            event("Nút cứng: đóng cửa", 3)
        else:
            event("Nút Đóng cửa bị bỏ qua: đang ở chế độ TỰ ĐỘNG", 1)

