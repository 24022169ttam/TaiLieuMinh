def load_json(name, target):
    try:
        with open(name) as f:
            target.update(json.load(f))
    except Exception:
        pass


def save_json(name, data):
    try:
        with open(name, "w") as f:
            json.dump(data, f)
    except Exception as e:
        print("Loi ghi", name, e)


class R:
    pass


r = R()
r.dist = -1.0; r.noise = 0.0; r.water = 0; r.car = False
r.auto = True; r.muted = False; r.latched = False; r.pre = False; r.blocked = False; r.buz = False
r.state = ST_SAFE; r.tgt = C.SERVO_OPEN; r.pos = C.SERVO_OPEN
r.last_valid = now(); r.diag = 0; r.misA = 0; r.misB = 0
