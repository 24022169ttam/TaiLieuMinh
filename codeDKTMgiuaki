import time, network
import config as C


def now():
    return time.ticks_ms()


def since(t):
    return time.ticks_diff(time.ticks_ms(), t)


# =============================== WI-FI (doi tuong) ===============================
sta = network.WLAN(network.STA_IF)
ap = network.WLAN(network.AP_IF)


# =============================== KET NOI WI-FI ===============================
wifi_idx = 0


def wifi_setup(lcd_line=lambda row, s: None):
    global wifi_idx
    try:
        network.hostname(C.HOSTNAME)
    except Exception:
        pass
    if getattr(C, "ENABLE_AP", False):
        ap.active(True)
        try:
            ap.config(essid=C.AP_SSID, password=C.AP_PASS, authmode=3)   # 3 = WPA2-PSK
        except Exception:
            ap.config(essid=C.AP_SSID, password=C.AP_PASS)
    else:
        ap.active(False)                       # khong phat Wi-Fi rieng
    sta.active(True)
    for i, (ssid, pw) in enumerate(C.WIFI_LIST):
        wifi_idx = i
        lcd_line(1, ssid)
        print("Thu Wi-Fi:", ssid)
        try:
            sta.disconnect()
            t1 = now()
            while sta.isconnected() and since(t1) < 1500:   # doi ngat han ket noi cu (sau soft reboot)
                time.sleep_ms(100)
        except Exception:
            pass
        try:
            sta.connect(ssid, pw)
        except Exception as e:
            print("Loi ket noi:", e)
        t0 = now()
        while not sta.isconnected() and since(t0) < 8000:
            time.sleep_ms(200)
        if sta.isconnected():
            break
    if sta.isconnected():
        ip = sta.ifconfig()[0]
        try:
            lcd_line(0, "WiFi:" + sta.config("essid"))
        except Exception:
            lcd_line(0, "WiFi:" + C.WIFI_LIST[wifi_idx][0])
        lcd_line(1, ip)
        try:
            real = sta.config("essid")             # ten Wi-Fi thuc su dang ket noi
        except Exception:
            real = C.WIFI_LIST[wifi_idx][0]
        print("Da vao Wi-Fi", real, "- HMI: http://" + ip)
    elif getattr(C, "ENABLE_AP", False):
        lcd_line(0, "AP:" + C.AP_SSID)
        lcd_line(1, ap.ifconfig()[0])
    else:
        lcd_line(0, "KHONG CO WIFI")
        lcd_line(1, "Dang thu lai...")
        print("Chua vao duoc Wi-Fi nao, se tu thu lai moi 15 s")
    if getattr(C, "ENABLE_AP", False):
        print("Wi-Fi rieng:", C.AP_SSID, "- HMI: http://" + ap.ifconfig()[0])

